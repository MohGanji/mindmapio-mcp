{
  "openapi": "3.1.0",
  "info": {
    "title": "Mindmap.io Node API",
    "version": "0.1.0",
    "description": "The agent-first unified node API for Mindmap.io (ADR 0022). One set of HTTP primitives drives maps for external agents, the canvas UI, and the future in-app chatbot. This document is the primary surface; an MCP server and/or an installable agent skill wrap it. This revision covers authentication, the read endpoints (list maps, read a full map, read a node, read a subtree), and the structural write primitives (create/delete a map, create/update/delete a node). Clients mint node ids, so a primitive can reference a not-yet-persisted node. It also covers the generative operations on a node — submit, auto-expand, retry, and interrupt.\n"
  },
  "servers": [
    {
      "url": "https://mindmap.io",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "maps",
      "description": "Read a user's maps and their node trees."
    },
    {
      "name": "nodes",
      "description": "Read individual nodes and subtrees."
    },
    {
      "name": "generation",
      "description": "Generative operations that invoke the LLM on a node."
    }
  ],
  "paths": {
    "/api/mindmaps": {
      "get": {
        "operationId": "listMindmaps",
        "tags": [
          "maps"
        ],
        "summary": "List the authenticated user's maps",
        "description": "Returns the metadata (no node tree) for every map owned by the token's user, newest first.\n",
        "x-mcp": {
          "title": "List maps",
          "readOnlyHint": true,
          "destructiveHint": false
        },
        "responses": {
          "200": {
            "description": "The user's maps.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MindMapSummary"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createMap",
        "tags": [
          "maps"
        ],
        "summary": "Create a map",
        "description": "Creates a map owned by the token's user. Pass an initial node tree in `data` (with a root node) so structural node primitives have a parent to hang from. Returns the new map's id.\n",
        "x-mcp": {
          "title": "Create a map",
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMapRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created map.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMapResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/mindmaps/{id}": {
